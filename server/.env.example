# Kopier til .env og fyll inn. Ingen av dem trengs for å starte serveren,
# men /api/melding krever modellen og SMS krever en leverandør.

BASE_URL=https://jajumi.example.no
PORT=8080
DB_FIL=./jajumi.db

# --- Modellen. Bytt disse tre, så bytter du leverandør. -----------------
MODELL_URL=https://api.x.ai/v1/chat/completions
MODELL_NAVN=grok-4.6
MODELL_NOKKEL=

# --- SMS. Avsender MÅ være et langt nummer, ikke et navn. --------------
# Alfanumerisk avsender kan ikke motta svar, og sløyfa hviler på svaret.
SMS_LEVERANDOR=logg
SMS_AVSENDER=+4759442011

# SMS_LEVERANDOR=sveve
SVEVE_BRUKER=
SVEVE_PASSORD=

# SMS_LEVERANDOR=twilio
TWILIO_SID=
TWILIO_TOKEN=
